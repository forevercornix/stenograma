{
  "name": "stenograma-backend",
  "license": "EUPL-1.2",
  "author": "Juliana Vorono-Baranovska",
  "version": "1.3.0",
  "description": "Stenograma - susitikimų protokolų generatoriaus backend (pluggable transcription + LLM providers)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/run-tests.mjs",
    "test:redis": "node scripts/run-tests.mjs redis",
    "test:postgres": "node scripts/run-tests.mjs postgres",
    "test:s3": "node scripts/run-tests.mjs s3",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "check": "find . -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n1 node --check",
    "lint": "eslint .",
    "doctor": "node scripts/doctor.js",
    "test-install": "node scripts/smoke.js",
    "test:all": "node --test",
    "test:security": "node scripts/run-tests.mjs security",
    "test:privacy": "node scripts/run-tests.mjs privacy",
    "test:functional": "node scripts/run-tests.mjs functional",
    "test:suites": "node scripts/run-tests.mjs --list",
    "test:matrix": "node scripts/check-security-matrix.mjs",
    "test:matrix-rows": "node scripts/check-matrix-rows.mjs",
    "test:deleted": "node scripts/check-deleted-tests.mjs",
    "test:clean": "node scripts/verify-clean.mjs --verify",
    "test:evidence": "node scripts/check-security-matrix.mjs && node scripts/check-matrix-rows.mjs && node scripts/run-tests.mjs --list"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "form-data": "^4.0.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.0",
    "node-pg-migrate": "^9.0.0",
    "papaparse": "^5.6.0",
    "pg": "^8.23.0",
    "pg-connection-string": "^2.14.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "bullmq": "^6.1.2",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "supertest": "^7.0.0",
    "yaml": "^2.9.0"
  }
}
