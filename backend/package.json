{
  "name": "stenograma-backend",
  "version": "1.0.3",
  "description": "Stenograma - susitikimų protokolų generatoriaus backend (pluggable transcription + LLM providers)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:redis": "node tests/queueRecovery.integration.test.js && node tests/heartbeatReadiness.integration.test.js",
    "check": "find . -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n1 node --check",
    "lint": "eslint .",
    "doctor": "node scripts/doctor.js",
    "test-install": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "form-data": "^4.0.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.0",
    "papaparse": "^5.5.4",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "bullmq": "^5.81.3",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "supertest": "^7.0.0",
    "yaml": "^2.9.0"
  }
}
