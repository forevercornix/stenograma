# syntax=docker/dockerfile:1.7
# Backend su GPU (device=cuda) LOKALIA transkripcija (faster-whisper-embedded).
#
# Skirtingai nuo Dockerfile.whisper (CPU), ŠIS naudoja CUDA bazinį image ir įdiegia
# GPU CUDA bibliotekas, tad `FASTER_WHISPER_DEVICE=cuda` REALIAI veikia konteineryje.
#
# Reikia: NVIDIA GPU + draiveriai + nvidia-container-toolkit host mašinoje, ir
# paleisti su GPU prieiga (`docker run --gpus all` arba compose deploy.resources -
# žr. docker-compose.gpu.yml).
#
# ⚠️  NEBUVO build-testuota šioje sandbox aplinkoje (nėra Docker daemon nei GPU) -
# bazinio image tag'ą ir CUDA versijų suderinamumą patikrinkite pirmo build'o metu.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

WORKDIR /app

# Node 20 + Python + ffmpeg. nvidia/cuda image neturi nei Node, nei Python.
# SVARBU: Ubuntu 22.04 sisteminis pip per senas --break-system-packages flag'ui
# (PEP 668 flag'as atsirado pip 23.0+). Atnaujinam pip, kad flag'as egzistuotų.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates python3 python3-pip ffmpeg \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && python3 -m pip install --upgrade pip \
 && rm -rf /var/lib/apt/lists/*

# Python priklausomybės (faster-whisper) SU GPU CUDA bibliotekomis, UŽFIKSUOTOS
# VERSIJOS (requirements-gpu.lock.txt) - deterministinis build, nesikeičia laikui bėgant.
COPY scripts/requirements-gpu.lock.txt ./scripts/requirements-gpu.lock.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --break-system-packages -r scripts/requirements-gpu.lock.txt

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev

COPY . .

ENV NODE_ENV=production
ENV FASTER_WHISPER_PYTHON_BIN=python3
ENV FASTER_WHISPER_DEVICE=cuda
ENV FASTER_WHISPER_COMPUTE_TYPE=float16
# LD_LIBRARY_PATH (nvidia-cublas/cudnn keliui) automatiškai nustato pats
# providerio kodas (FasterWhisperEmbeddedProvider._resolveCudaLibraryPath),
# tad čia jo rankiniu būdu nustatyti nereikia.
EXPOSE 3001

CMD ["node", "server.js"]
