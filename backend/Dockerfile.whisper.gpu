# syntax=docker/dockerfile:1.7
# Backend su GPU (device=cuda) LOKALIA transkripcija (faster-whisper-embedded).
#
# Skirtingai nuo Dockerfile.whisper (CPU), ŠIS naudoja CUDA bazinį image ir įdiegia
# GPU CUDA bibliotekas, tad `FASTER_WHISPER_DEVICE=cuda` REALIAI veikia konteineryje.
#
# Reikia: NVIDIA GPU + draiveriai + nvidia-container-toolkit host mašinoje, ir
# paleisti su GPU prieiga (`docker run --gpus all` arba compose deploy.resources -
# žr. docker-compose.gpu.yml).
#
# ✅ Build patikrintas GitHub Actions ("Publish images (GHCR)") - image sėkmingai
# sukuriamas. Realus veikimas su GPU (nvidia-container-toolkit + draiveriai)
# NEBUVO testuotas - patikrinkite pirmo paleidimo metu.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

WORKDIR /app

# Node 20 + Python 3.11 + ffmpeg. nvidia/cuda image neturi nei Node, nei Python.
# SVARBU: Ubuntu 22.04 default python yra 3.10, BET lock failas reikalauja 3.11+
# (av==18.0.0 ir kt.). Diegiam python3.11 per deadsnakes PPA. Atnaujinam pip, kad
# --break-system-packages flag'as egzistuotų (jis atsirado pip 23.0+).
#
# PASTABA (svarbu): `add-apt-repository` traukia GPG raktą iš keyserver.ubuntu.com
# per gpg/dirmngr, kuris NETURI numatytojo timeout - jei keyserver'is CI runner'yje
# lėtai atsako ar tinklas "pakimba", šis žingsnis gali kaboti VALANDŲ VALANDAS be
# jokios klaidos. Todėl gaubiame `timeout` + retry ciklu: po 3 nesėkmingų bandymų
# (max ~3min) build greitai failina, o ne kabo neribotą laiką.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates software-properties-common gnupg ffmpeg \
 && ( for i in 1 2 3; do \
        timeout 60 add-apt-repository -y ppa:deadsnakes/ppa && break || \
        { echo "add-apt-repository bandymas $i nepavyko, kartojama..."; sleep 5; }; \
        [ "$i" = 3 ] && { echo "add-apt-repository nepavyko po 3 bandymų"; exit 1; }; \
      done ) \
 && apt-get update && apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3.11-distutils \
 && curl -fsSL --connect-timeout 10 --max-time 60 https://bootstrap.pypa.io/get-pip.py | python3.11 - \
 && curl -fsSL --connect-timeout 10 --max-time 60 https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && python3.11 -m pip install --upgrade pip \
 && rm -rf /var/lib/apt/lists/*

# Python priklausomybės (faster-whisper) SU GPU CUDA bibliotekomis, UŽFIKSUOTOS
# VERSIJOS (requirements-gpu.lock.txt) - deterministinis build, nesikeičia laikui bėgant.
COPY scripts/requirements-gpu.lock.txt ./scripts/requirements-gpu.lock.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python3.11 -m pip install --break-system-packages -r scripts/requirements-gpu.lock.txt

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev

COPY . .

ENV NODE_ENV=production
ENV FASTER_WHISPER_PYTHON_BIN=python3.11
ENV FASTER_WHISPER_DEVICE=cuda
ENV FASTER_WHISPER_COMPUTE_TYPE=float16
# LD_LIBRARY_PATH (nvidia-cublas/cudnn keliui) automatiškai nustato pats
# providerio kodas (FasterWhisperEmbeddedProvider._resolveCudaLibraryPath),
# tad čia jo rankiniu būdu nustatyti nereikia.
EXPOSE 3001

CMD ["node", "server.js"]
