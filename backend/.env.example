# --- Serveris ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Saugumas ---
# Raktas, reikalingas GET /api/audit peržiūrai (rekomenduojama produkcijai; dev
# režime, jei paliksite tuščią, endpoint liks atviras su įspėjimu konsolėje).
AUDIT_API_KEY=

# Raktas, reikalingas /api/generate ir /api/transcribe (brangiausi endpoint'ai).
# ŠIS PROJEKTAS YRA MVP LOKALIAM/VIDINIAM NAUDOJIMUI, NE VIEŠAS SaaS.
# Jei paliksite tuščią, endpoint'ai liks atviri be autentifikacijos (leidžiama tik
# dev/lokaliam naudojimui - žr. backend/README.md). Viešam deployment'ui PRIVALOMA
# nustatyti šį raktą (arba pridėti tinkamesnę auth sistemą, pvz. sesijas/OAuth).
API_KEY=

# Kiek užklausų per langą leidžiama vienam IP (žr. express-rate-limit).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=20

# Job statuso patikrinimo (polling) endpoint'ams (GET /api/jobs/:id, GET
# /api/transcribe-jobs/:id) - ATSKIRAS, žymiai laisvesnis limitas nei aukščiau,
# nes frontend'as juos kviečia kas ~3s laukdamas ilgo transkribavimo/generavimo.
# RASTA REALIAI NAUDOJANT: su ta pačia griežta riba kaip POST endpoint'ams,
# bet koks >1 min užduotis atsitrenkdavo į rate limitą per patį polling'ą.
RATE_LIMIT_POLL_MAX_REQUESTS=120

# Ar /api/health rodyti tiekėjų/modelių detales. "public" - visada rodo (patogu demo/
# portfolio); "hidden" - produkcijoje rodo tik {status:"ok"}, nebent pridėtas teisingas
# x-audit-key. Numatyta pagal NODE_ENV (production => hidden, kitaip => public), bet
# galite priverstinai nurodyti čia.
HEALTH_DETAILS=

# Timeout (ms) visiems išoriniams API kvietimams (Claude/OpenAI/Deepgram/Azure/...).
API_TIMEOUT_MS=90000

# Kiek vienalaikių "embedded" (subprocess) transkribavimų leidžiama vienu metu -
# apsauga nuo CPU/RAM prisotinimo, jei keli vartotojai transkribuoja lokaliai
# tuo pačiu metu. Papildomos užklausos laukia eilėje, ne atmetamos.
#
# ⚠️ GPU KONTEKSTE (device=cuda): kiekviena užklausa paleidžia NAUJĄ Python
# procesą, kuris modelį įkelia į VRAM IŠ NAUJO (architektūra NĖRA persistent-
# model serveris). Su FASTER_WHISPER_MAX_CONCURRENCY>1 KELI procesai vienu metu
# bandytų įkelti modelį į TĄ PATĮ GPU vienu metu - su medium/large-v3 modeliais
# tai gali sukelti VRAM trūkumą (OOM) arba nenuspėjamą našumą. Pirmam GPU testui
# REKOMENDUOJAMA nustatyti į 1, kol turėsite realų VRAM sunaudojimo matavimą.
FASTER_WHISPER_MAX_CONCURRENCY=2

# Ar leisti klientui per užklausą (/api/generate, /api/transcribe) nurodyti
# konkretų tiekėją (llmProviderOverride / provider). Numatyta - IŠJUNGTA,
# kad vartotojas negalėtų perjungti į brangesnį tiekėją be jūsų žinios.
ALLOW_PROVIDER_OVERRIDE=false

# Maksimalus įkeliamo audio failo dydis megabaitais.
# Maksimalus įkeliamo audio failo dydis megabaitais. Numatyta 50MB tinka trumpiems
# įrašams/demo, bet REALŪS ilgi (kelių valandų) posėdžių įrašai gali siekti
# 200-500MB (pvz. 4 val. 128kbps MP3 ≈ 230MB - realiai testuota). Prieš testuojant
# su ilgais failais, padidinkite pagal savo poreikį.
MAX_UPLOAD_MB=500

# Kiek minučių COMPLETED/FAILED jobai (žr. /api/jobs) laikomi prieš automatinį
# išvalymą. QUEUED/PROCESSING jobai niekada nešalinami automatiškai.
JOB_TTL_MINUTES=60

# --- Job store persistencija (neprivaloma) ---
# Be REDIS_URL job'ai laikomi PROCESO ATMINTYJE - perkrovus backendą jie dingsta,
# nėra kelių worker'ių palaikymo. Tinka dev/demo/vieno vartotojo įrankiui.
# Su REDIS_URL job'ai persistuojami Redis'e (atsparu restartams, keli worker'iai).
# Jei REDIS_URL nustatytas, bet Redis neprieinamas, sistema GRĮŽTA į in-memory su
# įspėjimu (nebent REDIS_REQUIRED=true - tada kietas gedimas).
# REDIS_URL=redis://localhost:6379
# REDIS_REQUIRED=false

# --- BullMQ eilė ir worker'iai (su REDIS_URL) ---
# Su REDIS_URL HTTP backend TIK įdeda jobus į eilę; darbą vykdo ATSKIRAS worker
# procesas (node workers/index.js). Backend restartas nenutraukia darbo. Be REDIS_URL
# darbas vykdomas HTTP procese (inline - dabartinis dev elgesys).
# QUEUE_MAX_ATTEMPTS=3          # kiek kartų kartoti nepavykusį jobą
# QUEUE_BACKOFF_MS=5000         # eksponentinio backoff pradinis delsas
# QUEUE_TTL_SECONDS=3600        # kiek laikyti baigtus jobus eilėje
# QUEUE_STALLED_INTERVAL_MS=30000  # kaip dažnai tikrinti "užstrigusius" (stalled) jobus
# QUEUE_MAX_STALLED=2           # kiek kartų grąžinti stalled jobą prieš pažymint failed
# QUEUE_LOCK_DURATION_MS=600000 # job lock trukmė (turi viršyti ilgiausią transkripciją)
# WORKER_CONCURRENCY=2          # vienalaikių jobų vienam worker'iui
# STORAGE_DIR=./storage         # bendras audio storage (worker pasiekia failą pagal raktą)

# --- Transkribavimo tiekėjas: mock | whisper | faster-whisper | azure | google | deepgram ---
TRANSCRIPTION_PROVIDER=mock

# --- Diarizacija (kalbėtojų atskyrimas) - NEPRIKLAUSOMAS komponentas nuo transkribavimo ---
#   none          - diarizacijos nėra
#   inline        - naudoti PAČIO TRANSCRIPTION_PROVIDER diarizaciją (jei jis moka - Azure/Google/Deepgram/Mock)
#   mock          - testams/demo, be jokio rakto
#   pyannote      - atskiras lokalus etapas (nepriklauso nuo transkribavimo tiekėjo, veikia ir su Whisper)
#   pyannote-cloud
#   assemblyai
DIARIZATION_PROVIDER=none

# --- LLM tiekėjas protokolui generuoti: mock | claude | gpt | gemini ---
# SVARBU: numatyta "mock", nes be API rakto "claude"/"gpt"/"gemini" reikštų, kad
# backend'as iškart kris pirmoje užklausoje. Pakeiskite į realų tiekėją TIK kartu
# pridėję atitinkamą raktą žemiau.
LLM_PROVIDER=mock

# Maksimalus LLM ATSAKYMO ilgis tokenais. RASTA REALIAI: senoji hardcoded 1500
# reikšmė nukirpdavo ilgo (kelių valandų) susitikimo protokolo JSON viduryje -
# dabar nukirpimas aptinkamas ir grąžinama aiški klaida su šia rekomendacija.
# Ilgiems posėdžiams: 16000. (Analogiškai OPENAI_MAX_TOKENS, GEMINI_MAX_TOKENS.)
ANTHROPIC_MAX_TOKENS=8000

# Transkripcijos deduplikacija prieš siunčiant LLM: sutraukia Whisper
# haliucinacines kilpas (ta pati frazė šimtus kartų iš eilės tylos vietose -
# realiame 4 val. įraše tai sudarė 28% viso teksto!). Išjungti: false.
TRANSCRIPT_DEDUP=true

# --- Prompt versija (žr. prompts/index.js) - v3 turi injection mitigation IR ---
# --- aiškią scalar/masyvo laukų "trūksta info" disambiguaciją (žr. backend README) ---
PROMPT_VERSION=meeting_v3

# --- Raktai (pildykite tik tuos, kuriuos realiai naudojate) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

DEEPGRAM_API_KEY=

# --- Faster-Whisper: DU DIEGIMO PROFILIAI (žr. backend/README.md) ---
#
# "SERVER" profilis (TRANSCRIPTION_PROVIDER=faster-whisper-server arba faster-whisper):
# tikimasi ATSKIRAI paleisto HTTP serviso - naudinga bendram įmonės serveriui.
FASTER_WHISPER_URL=http://localhost:8000/transcribe
#
# "EMBEDDED" profilis (TRANSCRIPTION_PROVIDER=faster-whisper-embedded): JOKIO
# atskiro serverio - kviečia faster-whisper TIESIOGIAI per Python subprocess
# kiekvienai užklausai. Tinka sekretorės/vieno vartotojo kompiuteriui.
# Reikalauja: pip install -r scripts/requirements.txt
FASTER_WHISPER_PYTHON_BIN=python3
# Modelio pavadinimas (tiny/base/small/medium/large-v3 - atsisiunčiama automatiškai)
# ARBA kelias iki lokaliai jau turimo CTranslate2 modelio katalogo (patikrinta
# realiai - žr. backend/README.md "Faster-Whisper: du diegimo profiliai").
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
# Timeout Python procesui (embedded profilis) - didesnis nei API_TIMEOUT_MS, nes
# pirmas paleidimas gali reikšti modelio atsisiuntimą (gali užtrukti minutes).
# SVARBU (realiai patikrinta): apdorojimo trukmė NĖRA tiesiogiai proporcinga audio
# trukmei - tylos/triukšmo segmentai kartais užtrunka ILGIAU nei kalba (žr. backend
# README "Realaus audio testas"). Prieš pirmą testą su nauju modeliu/GPU, laikykite
# didelį saugos rezervą, kol turėsite realų matavimą savo aplinkoje.
FASTER_WHISPER_EMBEDDED_TIMEOUT_MS=3600000

# Multipart lauko pavadinimas, kurio tikisi jūsų pyannote serveris ("file",
# "audio", "audio_file"...) - nesutapimas duoda 400. Žr. RUNPOD.md troubleshooting.
PYANNOTE_FILE_FIELD=file
PYANNOTE_URL=http://localhost:8001/diarize
PYANNOTEAI_API_KEY=
ASSEMBLYAI_API_KEY=

# --- Apytikslės kainos audit logui (USD / 1M tokenų) - pasitikrinkite aktualias ---
PRICE_CLAUDE_INPUT_PER_MTOK=3
PRICE_CLAUDE_OUTPUT_PER_MTOK=15
