# syntax=docker/dockerfile:1.7
# Persistentus faster-whisper serveris (GPU, device=cuda).
# CUDA bazinis image + GPU CUDA bibliotekos, tad WHISPER_DEVICE=cuda realiai veikia.
#
# Reikia: NVIDIA GPU + nvidia-container-toolkit. Paleidimas su --gpus all arba
# compose deploy.resources.
#
# ✅ Build patikrintas GitHub Actions ("Publish images (GHCR)") - image sėkmingai
# sukuriamas. Realus veikimas su GPU (nvidia-container-toolkit + draiveriai)
# NEBUVO testuotas - patikrinkite pirmo paleidimo metu.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

WORKDIR /app

# Ubuntu 22.04 default python yra 3.10, BET lock failas reikalauja 3.11+ (av==18.0.0).
# Diegiam python3.11 per deadsnakes ir padarom jį numatytu `python3` (CMD naudoja python3).
#
# PASTABA (svarbu): `add-apt-repository` traukia GPG raktą iš keyserver.ubuntu.com
# per gpg/dirmngr, kuris NETURI numatytojo timeout - jei keyserver'is CI runner'yje
# lėtai atsako, šis žingsnis gali kaboti VALANDŲ VALANDAS be jokios klaidos. Todėl
# gaubiame `timeout` + retry ciklu: po 3 nesėkmingų bandymų build greitai failina.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates software-properties-common gnupg ffmpeg \
 && ( for i in 1 2 3; do \
        timeout 60 add-apt-repository -y ppa:deadsnakes/ppa && break || \
        { echo "add-apt-repository bandymas $i nepavyko, kartojama..."; sleep 5; }; \
        [ "$i" = 3 ] && { echo "add-apt-repository nepavyko po 3 bandymų"; exit 1; }; \
      done ) \
 && apt-get update && apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3.11-distutils \
 && curl -fsSL --connect-timeout 10 --max-time 60 https://bootstrap.pypa.io/get-pip.py | python3.11 - \
 && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
 && python3.11 -m pip install --upgrade pip \
 && rm -rf /var/lib/apt/lists/*

COPY requirements-gpu.lock.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    python3.11 -m pip install --break-system-packages -r requirements-gpu.lock.txt

COPY server.py ./

ENV PORT=8000
ENV WHISPER_MODEL=small
ENV WHISPER_DEVICE=cuda
ENV WHISPER_COMPUTE_TYPE=float16

# OPTIONAL: modelio pre-download BUILD metu. Su --build-arg PREDOWNLOAD_MODEL=1
# modelis "įkepamas" į image, tad PIRMAS paleidimas nelaukia atsisiuntimo (greičiau
# paleidžiama, bet image ~500MB-1GB didesnis). Be šito modelis atsisiunčiamas pirmo
# paleidimo metu (mažesnis image, bet pirmas startas lėtesnis).
ARG PREDOWNLOAD_MODEL=0
RUN if [ "$PREDOWNLOAD_MODEL" = "1" ]; then \
      python3 -c "from faster_whisper import WhisperModel; WhisperModel('${WHISPER_MODEL}', device='cpu', compute_type='int8')" ; \
    fi

EXPOSE 8000

CMD ["python3", "server.py"]
