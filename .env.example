# Stenograma - ŠAKNINIS .env (Docker Compose lygmens kintamieji).
#
# Nukopijuokite į .env ir užpildykite:  cp .env.example .env
#
# ⚠️  ŠIS failas (kai pervadintas į .env) TURI PASLAPČIŲ - jis yra .gitignore,
# NIEKADA jo necommitinkite.
#
# SKIRTUMAS nuo backend/.env:
#   - ŠIS (šakninis .env) - Docker Compose lygmens kintamieji, kuriuos Compose
#     skaito AUTOMATIŠKAI iš projekto šaknies (HUGGINGFACE_TOKEN, REGISTRY,
#     MODEL_CACHE_DIR ir pan. - ${VAR} pakaitalai compose failuose).
#   - backend/.env - backend APLIKACIJOS konfigūracija (LLM_PROVIDER, API raktai),
#     kurią Compose paduoda konteineriui per env_file.
#
# Kodėl patogu: nustačius HUGGINGFACE_TOKEN čia, nereikės jo eksportuoti iš naujo
# kiekvienoje terminalo sesijoje - ir Docker Compose, ir scripts/preflight-gpu.sh
# jį perskaitys automatiškai.

# Pyannote diarizacijai (GPU profilis). Gaukite: https://hf.co/settings/tokens
# ir priimkite sąlygas: https://hf.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# Paruoštų Docker image'ų registry (jei publikavote į GHCR). Palikus tuščią -
# image'ai statomi lokaliai. Pvz.: ghcr.io/jusu-vardas
REGISTRY=

# Modelių cache kelias (RunPod'e - persistent network volume, pvz. /workspace/models).
# Palikus tuščią - naudojamas įvardytas Docker volume (stenograma-models).
MODEL_CACHE_DIR=

# --- PostgreSQL (#155) ---
#
# ⚠️ 7.1 APIMTIS: DB servisas ir migracijų karkasas. `postgresStore` DAR
# NEEGZISTUOJA - `jobStore` šio kintamojo kol kas NENAUDOJA. Pagal ADR
# (ADR #177, docs/decisions/) jis prijungiamas 7.2a kaip TREČIAS
# backend'as, ir tik tada PostgreSQL tampa autoritetinga saugykla.
#
# ⚠️ DU KONFIGŪRAVIMO BŪDAI — NENAUDOKITE ABIEJŲ.
#
#   DATABASE_URL    – patogu lokaliai ir CI (vienas kintamasis).
#   PG* (PGHOST...) – naudoja Docker profiliai, nes slaptažodis su `/`, `?` ar
#                     `#` sukonstruotame URL reikštų kitką.
#
# Nustačius abu, `make doctor` neaišku, kurią DB tikrina — todėl jis grąžina
# KLAIDĄ, ne pirmenybę. Docker režime `DATABASE_URL` palikite tuščią.
#
# Šiandien DATABASE_URL reikalingas migracijoms (`npm run migrate:up`),
# `make doctor` diagnostikai ir PostgreSQL integraciniams testams.
#
# ⚠️ DATABASE_URL DAR NEPERJUNGIA job metaduomenų į PostgreSQL (#155, 7.2a).
# `postgresStore` įgyvendintas, bet ADR aktyvavimo barjeras reikalauja
# patikrinto restore (7.6), persistentinių ištrynimo žymų (7.5a) ir sąlyginio
# transakcinio užbaigimo (7.5b). Iki tol job'ai lieka Redis arba atmintyje, o
# serveris apie tai įspėja startuodamas. Žr. docs/decisions/155-postgres-authority.md.
#
# Servisas apibrėžtas docker-compose.gpu.yml (ne baziniame faile): desktop ir
# demo režimai sąmoningai veikia be jokios DB.
POSTGRES_DB=stenograma
POSTGRES_USER=stenograma
# PRIVALOMAS - compose kris su aiškia klaida, jei nenustatytas. Numatytosios
# reikšmės čia nėra sąmoningai: silpnas slaptažodis produkcijoje pavojingesnis
# nei nepavykęs startas.
POSTGRES_PASSWORD=
# Host prievadas migracijoms ir `make doctor` (jie vykdomi HOST'e, ne konteineryje).
#
# ⚠️ Pakeiskite, jei 5432 jau užimtas kito PostgreSQL - kitaip `make
# quickstart-gpu` nepasileis, nors 7.1 metu DB net nenaudojama.
#   POSTGRES_HOST_PORT=55432
#   DATABASE_URL=postgres://stenograma:slaptazodis@localhost:55432/stenograma
POSTGRES_HOST_PORT=5432
# Lokaliai (be Docker) - tiesioginis prisijungimas migracijoms ir testams:
# DATABASE_URL=postgres://stenograma:slaptazodis@localhost:5432/stenograma
DATABASE_URL=
