# syntax=docker/dockerfile:1.7
# Pyannote diarizacijos serveris su GPU (device=cuda).
#
# Skirtingai nuo pyannote-server/Dockerfile (CPU torch), ŠIS naudoja CUDA bazinį
# image ir GPU torch, tad torch.cuda.is_available() konteineryje bus True ir
# pipeline realiai naudos GPU (žymiai greičiau dideliems įrašams).
#
# Reikia: NVIDIA GPU + draiveriai + nvidia-container-toolkit host mašinoje, ir
# paleisti su GPU prieiga (`docker run --gpus all` arba compose deploy.resources).
#
# ✅ Build patikrintas GitHub Actions ("Publish images (GHCR)") - image sėkmingai
# sukuriamas. Realus veikimas su GPU (nvidia-container-toolkit + draiveriai)
# NEBUVO testuotas - patikrinkite pirmo paleidimo metu.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

WORKDIR /app

# Ubuntu 22.04 default python yra 3.10, BET lock failas reikalauja 3.11+. Diegiam
# python3.11 per deadsnakes ir padarom jį numatytu `python3` (CMD naudoja python3).
#
# PASTABA (svarbu): `add-apt-repository` traukia GPG raktą iš keyserver.ubuntu.com
# per gpg/dirmngr, kuris NETURI numatytojo timeout - jei keyserver'is CI runner'yje
# lėtai atsako, šis žingsnis gali kaboti VALANDŲ VALANDAS be jokios klaidos. Todėl
# gaubiame `timeout` + retry ciklu: po 3 nesėkmingų bandymų build greitai failina.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates software-properties-common gnupg ffmpeg \
 && ( for i in 1 2 3; do \
        timeout 60 add-apt-repository -y ppa:deadsnakes/ppa && break || \
        { echo "add-apt-repository bandymas $i nepavyko, kartojama..."; sleep 5; }; \
        [ "$i" = 3 ] && { echo "add-apt-repository nepavyko po 3 bandymų"; exit 1; }; \
      done ) \
 && apt-get update && apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3.11-distutils \
 && curl -fsSL --connect-timeout 10 --max-time 60 https://bootstrap.pypa.io/get-pip.py | python3.11 - \
 && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
 && python3.11 -m pip install --upgrade pip \
 && rm -rf /var/lib/apt/lists/*

COPY requirements-gpu.lock.txt ./
# GPU torch (CUDA 12.4) - įdiegiamas PRIEŠ pyannote.audio, kad pastarasis pasiimtų
# jau esantį GPU torch. Versijos užfiksuotos deterministiniam build'ui.
RUN --mount=type=cache,target=/root/.cache/pip \
    python3.11 -m pip install --break-system-packages \
      torch==2.5.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu124 \
 && python3.11 -m pip install --no-cache-dir --break-system-packages -r requirements-gpu.lock.txt

COPY server.py ./

ENV PORT=8001
EXPOSE 8001

CMD ["python3", "server.py"]
