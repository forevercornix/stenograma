# syntax=docker/dockerfile:1.7
# Pyannote diarizacijos serveris su GPU (device=cuda).
#
# Skirtingai nuo pyannote-server/Dockerfile (CPU torch), ŠIS naudoja CUDA bazinį
# image ir GPU torch, tad torch.cuda.is_available() konteineryje bus True ir
# pipeline realiai naudos GPU (žymiai greičiau dideliems įrašams).
#
# Reikia: NVIDIA GPU + draiveriai + nvidia-container-toolkit host mašinoje, ir
# paleisti su GPU prieiga (`docker run --gpus all` arba compose deploy.resources).
#
# ⚠️  NEBUVO build-testuota šioje sandbox aplinkoje (nėra Docker daemon nei GPU) -
# CUDA / torch cu124 versijų suderinamumą patikrinkite pirmo build'o metu.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

WORKDIR /app

# Ubuntu 22.04 default python yra 3.10, BET lock failas reikalauja 3.11+. Diegiam
# python3.11 per deadsnakes ir padarom jį numatytu `python3` (CMD naudoja python3).
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates software-properties-common ffmpeg \
 && add-apt-repository -y ppa:deadsnakes/ppa \
 && apt-get update && apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3.11-distutils \
 && curl -fsSL https://bootstrap.pypa.io/get-pip.py | python3.11 - \
 && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
 && python3.11 -m pip install --upgrade pip \
 && rm -rf /var/lib/apt/lists/*

COPY requirements-gpu.lock.txt ./
# GPU torch (CUDA 12.4) - įdiegiamas PRIEŠ pyannote.audio, kad pastarasis pasiimtų
# jau esantį GPU torch. Versijos užfiksuotos deterministiniam build'ui.
RUN --mount=type=cache,target=/root/.cache/pip \
    python3.11 -m pip install --break-system-packages \
      torch==2.5.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu124 \
 && python3.11 -m pip install --no-cache-dir --break-system-packages -r requirements-gpu.lock.txt

COPY server.py ./

ENV PORT=8001
EXPOSE 8001

CMD ["python3", "server.py"]
