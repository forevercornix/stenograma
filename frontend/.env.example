# Vite naudoja VITE_ prefiksą - be jo kintamasis nepasiekiamas per import.meta.env.
# Numatytas backend adresas lokaliam kūrimui.
VITE_BACKEND_URL=http://localhost:3001

# NEBŪTINA. Jei backend'e nustatėte API_KEY, galite jį perduoti čia, KAD frontend'as
# galėtų siųsti x-api-key header'į. SVARBU: šis raktas bus matomas kiekvienam, kas
# atidaro naršyklės dev tools ar peržiūri JS bundle'ą - tinka TIK vidiniam/lokaliam
# naudojimui (intranet, VPN), NIEKADA viešam internetui. Žr. backend/README.md.
VITE_API_KEY=
