+          if not has_gpu("transcription-worker"):
+              errors.append("GPU profilis: transcription-worker turi TURĖTI GPU (embedded faster-whisper)")
+          if has_gpu("protocol-worker"):
+              errors.append("GPU profilis: protocol-worker NETURI turėti GPU (tik LLM API kvietimas)")
+          if not has_gpu("pyannote"):
+              errors.append("GPU profilis: pyannote turi TURĖTI GPU")
+
+          if errors:
+              print("\n".join(errors), file=sys.stderr)
+              sys.exit(1)
+          print("OK: GPU profilio GPU paskirstymas teisingas.")
+          PYEOF
