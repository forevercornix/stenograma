+      - name: Patikrinti GPU/volume paskirstymą po merge (server profilis)
+        run: |
+          python3 - <<'PYEOF'
+          import json, sys
+
+          with open("/tmp/server-compose.json") as f:
+              cfg = json.load(f)
+          svc = cfg["services"]
+
+          def has_gpu(name):
+              devices = (svc[name].get("deploy") or {}).get("resources", {}).get("reservations", {}).get("devices", [])
+              return any(d.get("driver") == "nvidia" for d in devices)
+
+          def volume_targets(name):
+              """Grąžina servisio volume TARGET (konteinerio) kelius, aibe.
+              `docker compose config --format json` volumes visada JSON objektų
+              sąrašas su `target` raktu (long syntax) - jokio short "source:target"
+              string'o čia nebūna, tad papildomo string-parsing atvejo nereikia."""
+              return {v.get("target", "") for v in (svc[name].get("volumes") or [])}
+
+          errors = []
+          # Server profilyje backend IR transcription-worker naudoja whisper-server
+          # per HTTP - GPU jiems NEBEREIKIA (!reset override turi tai pašalinti).
+          if has_gpu("backend"):
+              errors.append("Server profilis: backend NETURI turėti GPU (naudoja whisper-server per HTTP) - !reset override neveikė!")
+          if has_gpu("transcription-worker"):
+              errors.append("Server profilis: transcription-worker NETURI turėti GPU (naudoja whisper-server per HTTP) - !reset override neveikė!")
+          if has_gpu("protocol-worker"):
+              errors.append("Server profilis: protocol-worker NETURI turėti GPU")
+          if not has_gpu("whisper"):
+              errors.append("Server profilis: whisper servisas TURI turėti GPU")
+
+          # /storage turi išlikti (audio worker'iui), /models NETURI likti backend/
+          # transcription-worker servisuose (!override turi jį pašalinti - modelis
+          # server profilyje gyvena TIK whisper servise).
+          for name in ("backend", "transcription-worker"):
+              targets = volume_targets(name)
+              if "/storage" not in targets:
+                  errors.append(f"Server profilis: {name} turi turėti /storage volume")
+              if "/models" in targets:
+                  errors.append(f"Server profilis: {name} NETURI turėti /models volume (!override neveikė?) - rasti targets: {targets}")
+
+          if errors:
+              print("\n".join(errors), file=sys.stderr)
+              sys.exit(1)
+          print("OK: server profilio GPU/volume paskirstymas teisingas.")
+          PYEOF
